---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { name, shortDescription, status, repositoryUrl, productUrl, docsUrl, technologies } = project.data;
const projectSlug = project.id.replace(/\.(md|mdx)$/, '');

// Get related blog posts
const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

const relatedPosts = allPosts
  .filter((post) => post.data.project === projectSlug)
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf())
  .slice(0, 5);

const statusLabels: Record<string, string> = {
  active: 'Active Development',
  maintained: 'Maintained',
  archived: 'Archived',
  experimental: 'Experimental',
  planned: 'Planned',
};
---

<BaseLayout title={name} description={shortDescription}>
  <article class="project-page">
    <header class="project-header">
      <div class="container">
        <div class="status-badge" data-status={status}>
          {statusLabels[status] || status}
        </div>
        <h1>{name}</h1>
        <p class="project-description">{shortDescription}</p>
        
        <div class="project-links">
          {repositoryUrl && (
            <a href={repositoryUrl} class="project-link" target="_blank" rel="noopener noreferrer">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
              </svg>
              Repository
            </a>
          )}
          {productUrl && (
            <a href={productUrl} class="project-link" target="_blank" rel="noopener noreferrer">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
              Website
            </a>
          )}
          {docsUrl && (
            <a href={docsUrl} class="project-link" target="_blank" rel="noopener noreferrer">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
              </svg>
              Documentation
            </a>
          )}
        </div>
        
        {technologies.length > 0 && (
          <div class="technologies">
            {technologies.map((tech) => (
              <span class="tech-tag">{tech}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="project-content container">
      <div class="prose">
        <slot />
      </div>
      
      {relatedPosts.length > 0 && (
        <aside class="related-posts">
          <h2>Related Posts</h2>
          <ul>
            {relatedPosts.map((post) => (
              <li>
                <a href={`/blog/${post.id.replace(/\.(md|mdx)$/, '')}/`}>{post.data.title}</a>
                <time datetime={post.data.publishedDate.toISOString()}>
                  {post.data.publishedDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
                </time>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .project-page {
    padding-block: var(--space-12);
  }

  .project-header {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .status-badge {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-4);
    background: var(--color-accent-subtle);
    color: var(--color-accent);
  }

  .status-badge[data-status="active"] {
    background: rgba(34, 197, 94, 0.15);
    color: #4ade80;
  }

  .status-badge[data-status="archived"] {
    background: rgba(107, 114, 128, 0.15);
    color: #9ca3af;
  }

  .status-badge[data-status="experimental"] {
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
  }

  .project-header h1 {
    margin-bottom: var(--space-4);
  }

  .project-description {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    max-width: 50ch;
    margin-inline: auto;
    margin-bottom: var(--space-6);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    margin-bottom: var(--space-6);
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: var(--text-sm);
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }

  .project-link:hover {
    border-color: var(--color-accent);
    background: var(--color-bg-subtle);
  }

  .technologies {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
  }

  .tech-tag {
    padding: var(--space-1) var(--space-2);
    background: var(--color-bg-card);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .project-content {
    display: grid;
    gap: var(--space-10);
    max-width: var(--max-width-content);
  }

  .related-posts {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-8);
  }

  .related-posts h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
  }

  .related-posts ul {
    list-style: none;
    padding: 0;
  }

  .related-posts li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .related-posts time {
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
    flex-shrink: 0;
  }
</style>
