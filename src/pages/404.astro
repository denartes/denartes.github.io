---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <section class="error-page">
    <div class="container">
      <div class="error-content">
        <span class="error-code">404</span>
        <h1>Page not found</h1>
        <p>The page you're looking for doesn't exist or has been moved.</p>
        <div class="error-links">
          <a href="/" class="error-link primary">Back to Home</a>
          <a href="/blog/" class="error-link secondary">Browse Posts</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-page {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: var(--space-16);
  }

  .error-content {
    text-align: center;
    max-width: 28rem;
  }

  .error-code {
    display: block;
    font-size: clamp(6rem, 20vw, 10rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--color-accent);
    opacity: 0.3;
    margin-bottom: var(--space-4);
  }

  .error-content h1 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-4);
  }

  .error-content p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
  }

  .error-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  .error-link {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-weight: 500;
    font-size: var(--text-sm);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .error-link.primary {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  .error-link.primary:hover {
    background: var(--color-text);
  }

  .error-link.secondary {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .error-link.secondary:hover {
    border-color: var(--color-accent);
  }
</style>
