            </a>
            <a href="https://linkedin.com/in/joelwdickinson" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </a>
            <a href="https://discord.gg/j2JgwtnTnA" target="_blank" rel="noopener noreferrer" aria-label="Discord">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z"/></svg>
            </a>
            <a href="mailto:denartes.dev@gmail.com" aria-label="Email">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            </a>
          </div>
        </section>

        <section class="activity-feed">
          <h2>Activity</h2>
          <div class="activity-log">
            {activityDates.map((dateStr) => (
              <div class="activity-group">
                <time class="activity-date" datetime={dateStr}>
                  {formatActivityDate(dateStr)}
                </time>
                <ul class="activity-items">
                  {groupedActivity[dateStr].map((item) => (
                    <li class="activity-item" data-type={item.type}>
                      {item.type === 'post' ? (
                        <>
                          <span class="activity-label">Published</span>
                          <a href={item.href} class="activity-link">{item.title}</a>
                        </>
                      ) : (
                        <>
                          <span class="activity-label">Released</span>
                          <a href={item.href} class="activity-link" target="_blank" rel="noopener noreferrer">{item.title}</a>
                        </>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  /* Releases Hero */
  .releases-hero {
    padding-block: var(--space-10) var(--space-12);
    border-bottom: 1px solid var(--color-border);
  }

  .releases-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-6);
  }

  .releases-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .releases-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }

  .release-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .release-card:hover {
    border-color: var(--color-accent-muted);
    transform: translateY(-2px);
  }

  .release-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .release-repo {
    color: var(--color-text);
    font-weight: 600;
    font-size: var(--text-lg);
    transition: color var(--transition-fast);
  }

  .release-card:hover .release-repo {
    color: var(--color-accent);
  }

  .release-tag {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-accent);
    padding: var(--space-1) var(--space-2);
    background: rgba(212, 176, 122, 0.1);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .release-name {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-2);
  }

  .release-body {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    line-height: 1.5;
    margin: 0;
    flex: 1;
  }

  .release-date {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    margin-top: var(--space-3);
  }

  .no-releases {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Journal Layout */
  .journal-layout {
    padding-block: var(--space-8) var(--space-16);
  }

  .journal-content {
    display: grid;
    gap: var(--space-12);
  }

  @media (min-width: 900px) {
    .journal-content {
      grid-template-columns: 1fr 16rem;
      gap: var(--space-16);
    }
  }

  .main-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  /* Section headings */
  h2 {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
  }

  /* Post list */
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-item {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .post-item:last-child {
    border-bottom: none;
  }

  .post-link {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    text-decoration: none;
    margin-bottom: var(--space-1);
  }

  .post-title {
    color: var(--color-text);
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .post-link:hover .post-title {
    color: var(--color-accent);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .post-project {
    color: var(--color-accent-muted);
  }

  .post-project::before {
    content: '·';
    margin-right: var(--space-3);
    color: var(--color-text-subtle);
  }

  .post-description {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
    margin: 0;
  }

  .see-more {
    display: inline-block;
    margin-top: var(--space-4);
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .see-more:hover {
    color: var(--color-accent);
  }

  /* Bio section */
  .bio {
    margin-bottom: var(--space-8);
  }

  .bio-avatar {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: var(--space-3);
  }

  .bio h2 {
    text-transform: none;
    letter-spacing: normal;
    font-size: var(--text-lg);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .bio p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0;
  }

  .bio-links {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .bio-links a {
    color: var(--color-text-subtle);
    transition: color var(--transition-fast);
  }

  .bio-links a:hover {
    color: var(--color-accent);
  }

  /* Activity feed */
  .sidebar {
    order: -1;
  }

  @media (min-width: 900px) {
    .sidebar {
      order: 0;
    }
  }

  .activity-feed h2 {
    margin-bottom: var(--space-4);
  }

  .activity-log {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .activity-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .activity-date {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent-muted);
  }

  .activity-items {
    list-style: none;
    padding: 0;
    margin: 0;
    padding-left: var(--space-3);
    border-left: 1px solid var(--color-border-subtle);
  }

  .activity-item {
    padding-block: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .activity-label {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    display: block;
  }

  .activity-link {
    color: var(--color-text);
    text-decoration: none;
  }

  .activity-link:hover {
    color: var(--color-accent);
  }

  .activity-item[data-type="release"] .activity-label {
    color: var(--color-accent-muted);
  }

  .empty-state {
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }
</style>
