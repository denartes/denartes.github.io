---
import BaseLayout from '@layouts/BaseLayout.astro';
import FormattedDate from '@components/FormattedDate.astro';
import '@/styles/prose.css';
import { getCollection } from 'astro:content';

// Fetch recent releases from GitHub
type GitHubRelease = {
  name: string;
  tag_name: string;
  html_url: string;
  published_at: string;
  body: string;
  repository: {
    name: string;
    full_name: string;
    html_url: string;
  };
};

async function fetchRecentReleases(): Promise<GitHubRelease[]> {
  try {
    // Fetch recent events to find releases across all repos
    const response = await fetch(
      'https://api.github.com/users/denartes/events?per_page=100',
      {
        headers: {
          'Accept': 'application/vnd.github+json',
          'User-Agent': 'denartes.github.io',
        },
      }
    );
    
    if (!response.ok) {
      console.warn('Failed to fetch GitHub events:', response.status);
      return [];
    }
    
    const events = await response.json();
    
    // Filter for release events
    const releaseEvents = events
      .filter((event: any) => event.type === 'ReleaseEvent')
      .slice(0, 3);
    
    return releaseEvents.map((event: any) => ({
      name: event.payload.release.name || event.payload.release.tag_name,
      tag_name: event.payload.release.tag_name,
      html_url: event.payload.release.html_url,
      published_at: event.payload.release.published_at,
      body: event.payload.release.body || '',
      repository: {
        name: event.repo.name.split('/')[1],
        full_name: event.repo.name,
        html_url: `https://github.com/${event.repo.name}`,
      },
    }));
  } catch (error) {
    console.warn('Error fetching GitHub releases:', error);
    return [];
  }
}

const recentReleases = await fetchRecentReleases();

// Get all posts
const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});
const recentPosts = allPosts
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf())
  .slice(0, 10);

// Build activity feed from posts and GitHub activity
type ActivityItem = {
  date: Date;
  type: 'post' | 'release';
  title: string;
  href: string;
  project?: string;
};

const activities: ActivityItem[] = [];

// Add posts to activity feed
allPosts.forEach((post) => {
  const slug = post.id.replace(/\.(md|mdx)$/, '');
  activities.push({
    date: post.data.publishedDate,
    type: 'post',
    title: post.data.title,
    href: `/blog/${slug}/`,
    project: post.data.project,
  });
});

// Add releases to activity feed
recentReleases.forEach((release) => {
  activities.push({
    date: new Date(release.published_at),
    type: 'release',
    title: `${release.repository.name} ${release.tag_name}`,
    href: release.html_url,
  });
});

// Sort by date descending and take recent
const recentActivity = activities
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 10);

// Group activities by date
const groupedActivity = recentActivity.reduce((groups, item) => {
  const dateKey = item.date.toISOString().split('T')[0];
  if (!groups[dateKey]) {
    groups[dateKey] = [];
  }
  groups[dateKey].push(item);
  return groups;
}, {} as Record<string, ActivityItem[]>);

const activityDates = Object.keys(groupedActivity).sort((a, b) => b.localeCompare(a));

function formatActivityDate(dateStr: string): string {
  const date = new Date(dateStr);
  const today = new Date();
  const yesterday = new Date(today);
  yesterday.setDate(yesterday.getDate() - 1);
  
  if (dateStr === today.toISOString().split('T')[0]) {
    return 'Today';
  }
  if (dateStr === yesterday.toISOString().split('T')[0]) {
    return 'Yesterday';
  }
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
}

function formatReleaseDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}

function truncateBody(body: string, maxLength: number = 100): string {
  if (!body) return '';
  const cleaned = body.replace(/^#+\s+.*/gm, '').replace(/\n+/g, ' ').trim();
  if (cleaned.length <= maxLength) return cleaned;
  return cleaned.slice(0, maxLength).trim() + '…';
}
---

<BaseLayout title="Denartes">
  <section class="releases-hero">
    <div class="container">
      <h2 class="releases-title">Recent Releases</h2>
      {recentReleases.length > 0 ? (
        <div class="releases-grid">
          {recentReleases.map((release) => (
            <a href={release.html_url} class="release-card" target="_blank" rel="noopener noreferrer">
              <div class="release-header">
                <span class="release-repo">{release.repository.name}</span>
                <span class="release-tag">{release.tag_name}</span>
              </div>
              <p class="release-name">{release.name}</p>
              {release.body && (
                <p class="release-body">{truncateBody(release.body)}</p>
              )}
              <time class="release-date" datetime={release.published_at}>
                {formatReleaseDate(release.published_at)}
              </time>
            </a>
          ))}
        </div>
      ) : (
        <p class="no-releases">No recent releases</p>
      )}
    </div>
  </section>

  <div class="journal-layout container">
    <div class="journal-content">
      <main class="main-column">
        <section class="latest-writing">
          <h2>Latest Posts</h2>
          {recentPosts.length > 0 ? (
            <ul class="post-list">
              {recentPosts.map((post) => {
                const slug = post.id.replace(/\.(md|mdx)$/, '');
                return (
                  <li class="post-item" data-platform>
                    <a href={`/blog/${slug}/`} class="post-link">
                      <span class="post-title">{post.data.title}</span>
                      <span class="post-meta">
                        <FormattedDate date={post.data.publishedDate} format="short" />
                        {post.data.project && (
                          <span class="post-project">{post.data.project}</span>
                        )}
                      </span>
                    </a>
                    <p class="post-description">{post.data.description}</p>
                  </li>
                );
              })}
            </ul>
          ) : (
            <p class="empty-state">Nothing here yet.</p>
          )}
          <a href="/blog/" class="see-more">All posts →</a>
        </section>
      </main>

      <aside class="sidebar">
        <section class="bio">
          <img src="/images/avatar.png" alt="Joel Dickinson" class="bio-avatar" />
          <h2>Joel Dickinson</h2>
          <p>IT professional from New Zealand specialising in delivering end-to-end technology solutions spanning software development, AI, automation, cloud platforms, and systems integration.</p>
          <div class="bio-links">
            <a href="https://github.com/denartes" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
