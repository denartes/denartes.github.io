---
import BaseLayout from '@layouts/BaseLayout.astro';
import FormattedDate from '@components/FormattedDate.astro';
import '@/styles/prose.css';
import { getCollection } from 'astro:content';

// Fetch recent releases from GitHub
type GitHubRelease = {
  name: string;
  tag_name: string;
  html_url: string;
  published_at: string;
  body: string;
  repository: {
    name: string;
    full_name: string;
    html_url: string;
  };
};

async function fetchRecentReleases(): Promise<GitHubRelease[]> {
  try {
    // Fetch recent events to find releases across all repos
    const response = await fetch(
      'https://api.github.com/users/denartes/events?per_page=100',
      {
        headers: {
          'Accept': 'application/vnd.github+json',
          'User-Agent': 'denartes.github.io',
        },
      }
    );
    
    if (!response.ok) {
      console.warn('Failed to fetch GitHub events:', response.status);
      return [];
    }
    
    const events = await response.json();
    
    // Filter for release events
    const releaseEvents = events
      .filter((event: any) => event.type === 'ReleaseEvent')
      .slice(0, 3);
    
    return releaseEvents.map((event: any) => ({
      name: event.payload.release.name || event.payload.release.tag_name,
      tag_name: event.payload.release.tag_name,
      html_url: event.payload.release.html_url,
      published_at: event.payload.release.published_at,
      body: event.payload.release.body || '',
      repository: {
        name: event.repo.name.split('/')[1],
        full_name: event.repo.name,
        html_url: `https://github.com/${event.repo.name}`,
      },
    }));
  } catch (error) {
    console.warn('Error fetching GitHub releases:', error);
    return [];
  }
}

const recentReleases = await fetchRecentReleases();

// Get all posts
const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});
const recentPosts = allPosts
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf())
  .slice(0, 10);

// Build activity feed from posts and GitHub activity
type ActivityItem = {
  date: Date;
  type: 'post' | 'release';
  title: string;
  href: string;
  project?: string;
};

const activities: ActivityItem[] = [];

// Add posts to activity feed
allPosts.forEach((post) => {
  const slug = post.id.replace(/\.(md|mdx)$/, '');
  activities.push({
    date: post.data.publishedDate,
    type: 'post',
    title: post.data.title,
    href: `/blog/${slug}/`,
    project: post.data.project,
  });
});

// Add releases to activity feed
recentReleases.forEach((release) => {
  activities.push({
    date: new Date(release.published_at),
    type: 'release',
    title: `${release.repository.name} ${release.tag_name}`,
    href: release.html_url,
  });
});

// Sort by date descending and take recent
const recentActivity = activities
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 10);

// Group activities by date
const groupedActivity = recentActivity.reduce((groups, item) => {
  const dateKey = item.date.toISOString().split('T')[0];
  if (!groups[dateKey]) {
    groups[dateKey] = [];
  }
  groups[dateKey].push(item);
  return groups;
}, {} as Record<string, ActivityItem[]>);

const activityDates = Object.keys(groupedActivity).sort((a, b) => b.localeCompare(a));

function formatActivityDate(dateStr: string): string {
  const date = new Date(dateStr);
  const today = new Date();
  const yesterday = new Date(today);
  yesterday.setDate(yesterday.getDate() - 1);
  
  if (dateStr === today.toISOString().split('T')[0]) {
    return 'Today';
  }
  if (dateStr === yesterday.toISOString().split('T')[0]) {
    return 'Yesterday';
  }
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
}

function formatReleaseDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}

function truncateBody(body: string, maxLength: number = 100): string {
  if (!body) return '';
  const cleaned = body.replace(/^#+\s+.*/gm, '').replace(/\n+/g, ' ').trim();
  if (cleaned.length <= maxLength) return cleaned;
  return cleaned.slice(0, maxLength).trim() + '…';
}
---

<BaseLayout title="Denartes">
  <section class="releases-hero" data-platform>
    <div class="container">
      <h2 class="releases-title">Recent Releases</h2>
      {recentReleases.length > 0 ? (
        <div class="releases-grid">
          {recentReleases.map((release) => (
            <a href={release.html_url} class="release-card" data-platform target="_blank" rel="noopener noreferrer">
              <div class="release-header">
                <span class="release-repo">{release.repository.name}</span>
                <span class="release-tag">{release.tag_name}</span>
              </div>
              <p class="release-name">{release.name}</p>
              {release.body && (
                <p class="release-body">{truncateBody(release.body)}</p>
              )}
              <time class="release-date" datetime={release.published_at}>
                {formatReleaseDate(release.published_at)}
              </time>
            </a>
          ))}
        </div>
      ) : (
        <p class="no-releases">No recent releases</p>
      )}
    </div>
  </section>

  <div class="journal-layout container">
    <div class="journal-content">
      <main class="main-column">
        <section class="latest-writing">
          <h2>Latest Posts</h2>
          {recentPosts.length > 0 ? (
            <ul class="post-list">
              {recentPosts.map((post) => {
                const slug = post.id.replace(/\.(md|mdx)$/, '');
                return (
                  <li class="post-item" data-platform>
                    <a href={`/blog/${slug}/`} class="post-link">
                      <span class="post-title">{post.data.title}</span>
                      <span class="post-meta">
                        <FormattedDate date={post.data.publishedDate} format="short" />
                        {post.data.project && (
                          <span class="post-project">{post.data.project}</span>
                        )}
                      </span>
                    </a>
                    <p class="post-description">{post.data.description}</p>
                  </li>
                );
              })}
            </ul>
          ) : (
            <p class="empty-state">Nothing here yet.</p>
          )}
          <a href="/blog/" class="see-more">All posts →</a>
        </section>
      </main>

      <aside class="sidebar">
        <section class="activity-feed">
          <h2>Activity</h2>
          <div class="activity-log">
            {activityDates.map((dateStr) => (
              <div class="activity-group">
                <time class="activity-date" datetime={dateStr}>
                  {formatActivityDate(dateStr)}
                </time>
                <ul class="activity-items">
                  {groupedActivity[dateStr].map((item) => (
                    <li class="activity-item" data-type={item.type}>
                      {item.type === 'post' ? (
                        <>
                          <span class="activity-label">Published</span>
                          <a href={item.href} class="activity-link">{item.title}</a>
                        </>
                      ) : (
                        <>
                          <span class="activity-label">Released</span>
                          <a href={item.href} class="activity-link" target="_blank" rel="noopener noreferrer">{item.title}</a>
                        </>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  /* Releases Hero */
  .releases-hero {
    padding-block: var(--space-10) var(--space-12);
    border-bottom: 1px solid var(--color-border);
  }

  .releases-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-6);
  }

  .releases-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .releases-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }

  .release-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .release-card:hover {
    border-color: var(--color-accent-muted);
    transform: translateY(-2px);
  }

  .release-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .release-repo {
    color: var(--color-text);
    font-weight: 600;
    font-size: var(--text-lg);
    transition: color var(--transition-fast);
  }

  .release-card:hover .release-repo {
    color: var(--color-accent);
  }

  .release-tag {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-accent);
    padding: var(--space-1) var(--space-2);
    background: rgba(212, 176, 122, 0.1);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .release-name {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-2);
  }

  .release-body {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    line-height: 1.5;
    margin: 0;
    flex: 1;
  }

  .release-date {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    margin-top: var(--space-3);
  }

  .no-releases {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Journal Layout */
  .journal-layout {
    padding-block: var(--space-8) var(--space-16);
  }

  .journal-content {
    display: grid;
    gap: var(--space-12);
  }

  @media (min-width: 900px) {
    .journal-content {
      grid-template-columns: 1fr 16rem;
      gap: var(--space-16);
    }
  }

  .main-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  /* Section headings */
  h2 {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
  }

  /* Post list */
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-item {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .post-item:last-child {
    border-bottom: none;
  }

  .post-link {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    text-decoration: none;
    margin-bottom: var(--space-1);
  }

  .post-title {
    color: var(--color-text);
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .post-link:hover .post-title {
    color: var(--color-accent);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .post-project {
    color: var(--color-accent-muted);
  }

  .post-project::before {
    content: '·';
    margin-right: var(--space-3);
    color: var(--color-text-subtle);
  }

  .post-description {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
    margin: 0;
  }

  .see-more {
    display: inline-block;
    margin-top: var(--space-4);
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .see-more:hover {
    color: var(--color-accent);
  }

  /* Activity feed */
  .sidebar {
    order: -1;
  }

  @media (min-width: 900px) {
    .sidebar {
      order: 0;
    }
  }

  .activity-feed h2 {
    margin-bottom: var(--space-4);
  }

  .activity-log {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .activity-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .activity-date {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent-muted);
  }

  .activity-items {
    list-style: none;
    padding: 0;
    margin: 0;
    padding-left: var(--space-3);
    border-left: 1px solid var(--color-border-subtle);
  }

  .activity-item {
    padding-block: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .activity-label {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    display: block;
  }

  .activity-link {
    color: var(--color-text);
    text-decoration: none;
  }

  .activity-link:hover {
    color: var(--color-accent);
  }

  .activity-item[data-type="release"] .activity-label {
    color: var(--color-accent-muted);
  }

  .empty-state {
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }
</style>
